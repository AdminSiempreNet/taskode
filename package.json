{
  "name": "taskode-proyectos",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/prepare-excalidraw.mjs",
    "prebuild": "node scripts/prepare-excalidraw.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 5010",
    "email:preview": "tsx scripts/preview-invitation.ts",
    "build": "next build",
    "build:vercel": "npm run check:production && npm run db:migrate && npm run build",
    "check:production": "tsx scripts/check-production.ts",
    "check:ably": "tsx scripts/check-ably.ts",
    "setup:notifications": "tsx scripts/setup-notifications.ts",
    "test:realtime:live": "node --import tsx --test tests/realtime-live.mjs",
    "prepare:dokploy": "node scripts/deploy-dokploy.mjs prepare",
    "start": "next start --hostname 0.0.0.0 --port 5010",
    "typecheck": "tsc --noEmit",
    "test": "tsx --require ./tests/register-css.cjs --test --test-concurrency=4 tests/*.test.ts",
    "test:http": "node --import tsx --test tests/http-smoke.mjs",
    "test:notifications:browser": "node --import tsx --test tests/notifications-browser.mjs",
    "test:documents:browser": "node --import tsx --test tests/documents-browser.mjs",
    "test:mentions:browser": "node --import tsx --test tests/mentions-browser.mjs",
    "test:diagrams:browser": "node --import tsx --test tests/diagrams-browser.mjs",
    "test:notifications:live": "node --import tsx --test tests/notifications-realtime-live.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:tareas": "tsx scripts/seed-tareas.ts",
    "db:seed:dashboard": "tsx scripts/seed-dashboard.ts",
    "db:up": "docker compose --env-file .env.local -f compose.dev.yaml up -d --wait",
    "db:down": "docker compose --env-file .env.local -f compose.dev.yaml down",
    "build:migrator": "esbuild scripts/migrate.ts --bundle --platform=node --packages=external --format=cjs --outfile=dist/migrate.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-youtube": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/functions": "^3.10.1",
    "ably": "^2.29.0",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "emoji-picker-react": "^5.0.0",
    "file-type": "^22.2.0",
    "jose": "^6.2.12",
    "marked": "^17.0.6",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "6.11.3",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "resend": "^6.33.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid@3.3.3": "3.3.20",
      "sass": "1.105.2",
      "lodash-es": "4.18.1"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16",
      "lodash-es": "4.18.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
