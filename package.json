{
  "name": "brote-proyectos",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 5010",
    "build": "next build",
    "build:vercel": "npm run check:production && npm run db:migrate && npm run build",
    "check:production": "tsx scripts/check-production.ts",
    "prepare:dokploy": "node scripts/deploy-dokploy.mjs prepare",
    "start": "next start --hostname 0.0.0.0 --port 5010",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:http": "node --import tsx --test tests/http-smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:up": "docker compose --env-file .env.local -f compose.dev.yaml up -d --wait",
    "db:down": "docker compose --env-file .env.local -f compose.dev.yaml down",
    "build:migrator": "esbuild scripts/migrate.ts --bundle --platform=node --packages=external --format=cjs --outfile=dist/migrate.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/functions": "^3.10.1",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "emoji-picker-react": "^5.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "resend": "^6.33.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
