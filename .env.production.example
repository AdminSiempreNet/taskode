# Plantilla para Vercel > siemprenet > proyecto tareas > Environment Variables > Production.
# No subas a Git archivos con valores reales. No uses prefijos NEXT_PUBLIC_ para secretos.
# Guarda los valores reales en .env.production.local (excluido de Git y de los archivos enviados a Vercel).
# La CLI cargará únicamente las variables de esta plantilla en el entorno Production de Vercel.
DATABASE_URL=postgresql://taskode:REEMPLAZAR@dbtaskode.siempre.net.co:5440/taskode
DATABASE_SSL=verify-full
# Obligatorio en esta instalación: certificado de la CA privada de PostgreSQL, nunca su clave.
# Para otras instalaciones con CA pública es opcional. PEM completo;
# Vercel admite valor multilínea y también se admiten saltos escapados con \n.
DATABASE_SSL_CA=
# Cada instancia mantiene su pool. Reserva margen para migraciones y administración.
DATABASE_POOL_MAX=5
BETTER_AUTH_URL=https://taskode.siempre.net.co
BETTER_AUTH_SECRET=
# Configura al menos un proveedor. Callback: BETTER_AUTH_URL/api/auth/callback/google (o github).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Clave distinta de desarrollo, limitada a taskode-production:* (Publish + Subscribe).
ABLY_API_KEY=
ABLY_CHANNEL_NAMESPACE=taskode-production
BACKUP_STORAGE=s3
ATTACHMENT_STORAGE=s3
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com ; región auto.
# B2: https://s3.<REGION>.backblazeb2.com ; región exacta del bucket.
S3_ENDPOINT=https://REEMPLAZAR.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=taskode/production/
S3_FORCE_PATH_STYLE=false
# Generar un par exclusivo de producción: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://taskode.siempre.net.co
NOTIFICATION_WORKER_SECRET=
# Servidor MCP en /api/mcp (docs/mcp.md). Opcional: false lo desactiva.
# MCP_ENABLED=true
# Orígenes https de clientes MCP de navegador, separados por comas.
# MCP_ALLOWED_ORIGINS=
