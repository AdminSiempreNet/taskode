# Variables para PostgreSQL y el programador en Dokploy. Secretos independientes de desarrollo.
POSTGRES_DB=taskode
TASKODE_DB_USER=taskode
# Si ya hay datos, fija el nombre físico del volumen antes de iniciar Compose:
# TASKODE_POSTGRES_VOLUME=nombre-del-volumen-existente
POSTGRES_PASSWORD=
TASKODE_DB_PASSWORD=
# Puerto TCP externo, libre en el servidor. DATABASE_URL de taskode-web usa este mismo puerto.
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=0.0.0.0
# Directorio ABSOLUTO del servidor Dokploy con server.crt y server.key (no en Git).
POSTGRES_TLS_DIR=/etc/dokploy/certificates/tareas-postgres
# Debe coincidir con el secreto de la aplicación taskode-web (mínimo 32 caracteres).
NOTIFICATION_WORKER_SECRET=
NOTIFICATION_PROCESS_URL=https://taskode.siempre.net.co/api/internal/notifications/process
