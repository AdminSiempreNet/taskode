# Variables solo para el Compose de PostgreSQL en Dokploy. Secretos nuevos e independientes de desarrollo.
POSTGRES_DB=taskode
TASKODE_DB_USER=taskode
# Si ya hay datos, fija el nombre físico del volumen antes de iniciar Compose:
# TASKODE_POSTGRES_VOLUME=nombre-del-volumen-existente
POSTGRES_PASSWORD=
TASKODE_DB_PASSWORD=
# Puerto TCP externo, libre en el servidor. DATABASE_URL de Vercel usa este mismo puerto.
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=0.0.0.0
# Directorio ABSOLUTO del servidor Dokploy con server.crt y server.key (no en Git).
POSTGRES_TLS_DIR=/etc/dokploy/certificates/tareas-postgres
