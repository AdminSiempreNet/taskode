DATABASE_PATH=./data/brote.sqlite
# URL pública exacta, sin barra final. En producción usa HTTPS.
BETTER_AUTH_URL=http://localhost:5010
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Callback: http://localhost:5010/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: http://localhost:5010/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Usa un remitente de un dominio verificado en Resend.
# Sin estas variables, las invitaciones se pueden crear y copiar, pero no enviar.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Solo para scripts/deploy-dokploy.mjs. No se envía al contenedor.
DOKPLOY_API_KEY=
