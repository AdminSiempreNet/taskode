# Credenciales de ejemplo SOLO para desarrollo. En producción genera secretos nuevos.
POSTGRES_DB=brote
POSTGRES_PASSWORD=postgres-local-dev
BROTE_DB_PASSWORD=brote-local-dev
DATABASE_URL=postgresql://brote:brote-local-dev@127.0.0.1:5432/brote
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
TEST_DATABASE_URL=postgresql://brote:brote-local-dev@127.0.0.1:5432/brote_test
BACKUP_DIR=./data/backups
BACKUP_STORAGE=filesystem
# Para probar R2 o B2 localmente: BACKUP_STORAGE=s3 y variables S3 de .env.production.example.
# Usa otro bucket o S3_PREFIX=tareas/development/ para separar los respaldos.
# URL pública exacta, sin barra final. En producción usa HTTPS.
BETTER_AUTH_URL=http://localhost:5010
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Callback: http://localhost:5010/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: http://localhost:5010/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Usa un remitente de un dominio verificado en Resend.
# Sin estas variables, las invitaciones se pueden crear y copiar, pero no enviar.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
