# Credenciales de ejemplo SOLO para desarrollo. En producción genera secretos nuevos.
POSTGRES_DB=taskode
TASKODE_DB_USER=taskode
# En instalaciones existentes, conserva también el proyecto y volumen actuales:
# COMPOSE_PROJECT_NAME=nombre-del-proyecto-existente
# TASKODE_DEV_POSTGRES_VOLUME=nombre-del-volumen-existente
POSTGRES_PASSWORD=postgres-local-dev
TASKODE_DB_PASSWORD=taskode-local-dev
DATABASE_URL=postgresql://taskode:taskode-local-dev@127.0.0.1:5432/taskode
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
TEST_DATABASE_URL=postgresql://taskode:taskode-local-dev@127.0.0.1:5432/taskode_test
BACKUP_DIR=./data/backups
BACKUP_STORAGE=filesystem
# Para probar R2 o B2 localmente: BACKUP_STORAGE=s3 y variables S3 de .env.production.example.
# Los adjuntos son independientes de los respaldos; por defecto se guardan localmente.
ATTACHMENT_STORAGE=filesystem
ATTACHMENT_DIR=./data/attachments
# Usa otro bucket o S3_PREFIX=tareas/development/ para separar los respaldos.
# URL pública exacta, sin barra final. En producción usa HTTPS.
BETTER_AUTH_URL=http://localhost:5010
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Callback: http://localhost:5010/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: http://localhost:5010/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Usa un remitente de un dominio verificado en Resend.
# Sin estas variables, las invitaciones se pueden crear y copiar, pero no enviar.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Clave privada del servidor; nunca usar NEXT_PUBLIC_. Permisos Publish + Subscribe.
ABLY_API_KEY=
ABLY_CHANNEL_NAMESPACE=taskode-development
# Genera un par local con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Mismo secreto en la API y su programador; al menos 32 caracteres.
NOTIFICATION_WORKER_SECRET=
# Servidor MCP en /api/mcp (docs/mcp.md). Opcional: false lo desactiva.
# MCP_ENABLED=true
# Orígenes de clientes MCP de navegador, separados por comas (p. ej. MCP Inspector).
# MCP_ALLOWED_ORIGINS=http://localhost:6274
